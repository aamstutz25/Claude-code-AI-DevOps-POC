# Local settings template. Copy to .env (git-ignored) and fill in DB_PASSWORD.
# Never commit .env or put real credentials in this file.

# --- API server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- SQL Server connection ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=HelloPoc
DB_ENCRYPT=true

# LOCAL PHASE 1 DEVELOPMENT ONLY: accepts SQL Server's self-signed certificate.
# This is NOT the TEST/PROD standard. Those environments must use a certificate
# from a trusted authority with DB_TRUST_SERVER_CERTIFICATE=false (the code default).
DB_TRUST_SERVER_CERTIFICATE=true

# --- Credentials ---
# Credential provider. Phase 1 implements only "env": a single SQL login read from
# this file (re-read on every connection, so a changed password is picked up without
# a restart). A PAM provider will be added later without changing the rest of the app.
DB_CREDENTIAL_PROVIDER=env
DB_USER=poc_app
DB_PASSWORD=
