# Local settings template. Copy to .env (git-ignored) and fill in DB_PASSWORD.
# Never commit .env or put real credentials in this file.

# --- API server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- SQL Server connection ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=HelloPoc
DB_ENCRYPT=true

# LOCAL PHASE 1 DEVELOPMENT ONLY: accepts SQL Server's self-signed certificate.
# This is NOT the TEST/PROD standard. Those environments must use a certificate
# from a trusted authority with DB_TRUST_SERVER_CERTIFICATE=false (the code default).
DB_TRUST_SERVER_CERTIFICATE=true

# After a failed login the same credentials are not retried for this many seconds, so a
# wrong password cannot lock the SQL login out. Changed credentials are tried at once.
DB_LOGIN_COOLDOWN_SECONDS=300

# --- Credentials ---
# Credential provider. Phase 1 implements only "env": logins read from this file
# (re-read on every connection, so a changed password is picked up without a restart).
# A PAM provider will be added later without changing the rest of the app.
DB_CREDENTIAL_PROVIDER=env

# Wrap passwords in single quotes, e.g. DB_PASSWORD='p#ss$word'. Without quotes,
# everything after a # is treated as a comment and the password is cut short.

# Runtime identity: the only login the running application uses. Least privilege:
# member of the app_runtime role only (see database/README.md).
DB_USER=poc_app
DB_PASSWORD=

# Migration (deployment) identity: used only by `npm run db:migrate`. Never given to
# the running application. In TEST/PROD only the deployment pipeline holds it.
DB_MIGRATION_USER=poc_migrator
DB_MIGRATION_PASSWORD=
